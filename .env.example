# Variáveis de configuração do Cofre (docs/08-ambiente-e-agentes.md §3).
# Este arquivo é só documentação: a aplicação lê o ambiente, não este arquivo.

# Ambiente: production, development ou test. Parâmetros criptográficos reduzidos só em test.
COFRE_ENV=production
# URL do banco (SQLAlchemy, apenas sqlite), relativa ao diretório de execução.
COFRE_DATABASE_URL=sqlite:///./data/cofre.db
# Validade da sessão em minutos (RN-05).
COFRE_SESSION_TTL_MINUTES=30
# Falhas de login antes do bloqueio (RN-14, RN-16).
COFRE_LOGIN_MAX_ATTEMPTS=5
# Duração do bloqueio de login em minutos (RN-14, RN-16).
COFRE_LOGIN_LOCK_MINUTES=15
# Limite de credenciais por usuário (RN-07).
COFRE_MAX_CREDENTIALS_PER_USER=1000
# Memória do Argon2id em KiB (mínimo 19456 fora de test).
COFRE_ARGON2_MEMORY_KIB=19456
# Iterações do Argon2id (mínimo 2 fora de test).
COFRE_ARGON2_TIME_COST=2
# Paralelismo do Argon2id (mínimo 1).
COFRE_ARGON2_PARALLELISM=1
# Nível de log: DEBUG, INFO, WARNING, ERROR ou CRITICAL.
COFRE_LOG_LEVEL=INFO
